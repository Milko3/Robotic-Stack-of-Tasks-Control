<?xml version="1.0"?>
<!-- Panda arm (no hand) with ros2_control mock hardware that integrates velocity commands.
     The arm itself is the course's franka_gazebo panda_arm.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">

  <link name="world"/>
  <xacro:include filename="$(find sot_ros)/urdf/panda_arm.xacro"/>
  <xacro:panda_arm arm_id="panda" safety_distance="0.03" connected_to="world" description_pkg="sot_ros"/>

  <!-- Start configuration, same as Q_START in sot.cpp -->
  <xacro:property name="q_start" value="${[0.0, -0.4, 0.0, -1.8, 0.0, 1.4, 0.7]}"/>

  <ros2_control name="PandaMockHardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <!-- integrate commanded velocities into positions every cycle -->
      <param name="calculate_dynamics">true</param>
    </hardware>

    <xacro:macro name="sot_joint" params="i vmax">
      <joint name="panda_joint${i}">
        <command_interface name="velocity">
          <param name="min">-${vmax}</param>
          <param name="max">${vmax}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${q_start[i-1]}</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <xacro:sot_joint i="1" vmax="2.175"/>
    <xacro:sot_joint i="2" vmax="2.175"/>
    <xacro:sot_joint i="3" vmax="2.175"/>
    <xacro:sot_joint i="4" vmax="2.175"/>
    <xacro:sot_joint i="5" vmax="2.61"/>
    <xacro:sot_joint i="6" vmax="2.61"/>
    <xacro:sot_joint i="7" vmax="2.61"/>
  </ros2_control>
</robot>
